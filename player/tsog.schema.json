{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsiclear-4dgs.github.io/ftgs-player/tsog.schema.json",
  "title": "TSOG Playback Profile 1 metadata (including legacy v4 imports)",
  "description": "Structural constraints only. TSOG-SPEC.md defines cross-field, archive, pixel and playback requirements. Conforming new writers must include profile; legacy readers may accept its absence.",
  "type": "object",
  "required": ["version", "count", "means", "scales", "quats", "sh0"],
  "properties": {
    "version": { "const": 4 },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "org.opsiclear.tsog-playback" },
        "version": { "const": 1 }
      }
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "means": {
      "type": "object",
      "required": ["mins", "maxs", "files"],
      "properties": {
        "mins": { "$ref": "#/$defs/vector3" },
        "maxs": { "$ref": "#/$defs/vector3" },
        "files": { "$ref": "#/$defs/twoFiles" }
      }
    },
    "scales": { "$ref": "#/$defs/codebookImage" },
    "quats": {
      "type": "object", "required": ["files"],
      "properties": { "files": { "$ref": "#/$defs/oneFile" } }
    },
    "sh0": { "$ref": "#/$defs/codebookImage" },
    "shN": {
      "type": "object", "required": ["count", "bands", "codebook", "files"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "bands": { "type": "integer", "minimum": 1, "maximum": 3 },
        "codebook": { "$ref": "#/$defs/codebook" },
        "files": { "$ref": "#/$defs/twoFiles" }
      }
    },
    "timeline": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "N", "delta", "files"],
          "properties": {
            "type": { "const": 0 },
            "N": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "delta": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "files": { "$ref": "#/$defs/twoFiles" }
          }
        },
        {
          "type": "object", "required": ["type", "mins", "maxs", "files"],
          "properties": {
            "type": { "const": 1 },
            "mins": { "$ref": "#/$defs/timeRange" },
            "maxs": { "$ref": "#/$defs/timeRange" },
            "files": { "$ref": "#/$defs/twoFiles" }
          }
        }
      ]
    },
    "temporal": {
      "type": "object", "required": ["means"], "additionalProperties": false,
      "properties": {
        "means": {
          "type": "object", "required": ["mins", "maxs", "files"],
          "properties": {
            "mins": { "$ref": "#/$defs/motionRange" },
            "maxs": { "$ref": "#/$defs/motionRange" },
            "files": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/attributePath" } }
          }
        }
      }
    },
    "fps": { "$ref": "#/$defs/positive" },
    "playback": {
      "type": "object",
      "properties": {
        "duration": { "$ref": "#/$defs/positive" },
        "fps": { "$ref": "#/$defs/positive" },
        "rate": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "loop": { "type": "boolean" }
      }
    },
    "audio": {
      "type": "object", "required": ["file"],
      "properties": {
        "file": { "$ref": "#/$defs/attributePath" },
        "mimeType": { "type": "string", "pattern": "^[aA][uU][dD][iI][oO]/[a-zA-Z0-9.+-]+$(?![\\s\\S])" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "anyOf": [
        { "required": ["mimeType"] },
        { "properties": { "file": { "pattern": "\\.([mM][pP]3|[mM]4[aA]|[aA][aA][cC]|[oO][gG][gGaA]|[oO][pP][uU][sS]|[wW][aA][vV]|[fF][lL][aA][cC]|[wW][eE][bB][mM])$" } } }
      ]
    }
  },
  "dependentRequired": { "temporal": ["timeline"] },
  "allOf": [
    {
      "if": { "required": ["audio"], "not": { "required": ["timeline"] } },
      "then": { "required": ["playback"], "properties": { "playback": { "required": ["duration"] } } }
    }
  ],
  "$defs": {
    "positive": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.7976931348623157e308 },
    "float32": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 },
    "path": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\\\u0000-\\u001f:?#])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).+$"
    },
    "attributePath": { "allOf": [{ "$ref": "#/$defs/path" }, { "not": { "const": "meta.json" } }] },
    "oneFile": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/attributePath" } },
    "twoFiles": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/attributePath" } },
    "vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/float32" } },
    "timeRange": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [ { "$ref": "#/$defs/float32" }, { "allOf": [{ "$ref": "#/$defs/float32" }, { "exclusiveMinimum": 0 }] } ]
    },
    "motionRange": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/vector3" } },
    "codebook": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/float32" } },
    "codebookImage": {
      "type": "object", "required": ["codebook", "files"],
      "properties": { "codebook": { "$ref": "#/$defs/codebook" }, "files": { "$ref": "#/$defs/oneFile" } }
    }
  }
}
